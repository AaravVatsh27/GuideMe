# App
NEXT_PUBLIC_APP_URL=

# Auth.js
AUTH_URL=
AUTH_SECRET=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
AUTH_TRUST_HOST=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database
# Prisma Client runtime URL:
# Supabase transaction pooler on port 6543 with `pgbouncer=true`.
# For serverless/edge deploys, you can also append `&connection_limit=1`.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Prisma CLI URL for migrations/introspection:
# Prefer the direct database host on port 5432. If your environment is IPv4-only,
# Supabase session mode on port 5432 is an acceptable fallback.
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GUIDEME_SYSTEM_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
GUIDEME_COMMUNITY_WHATSAPP_URL=

# File Uploads
UPLOADTHING_TOKEN=

# Video
DAILY_API_KEY=
NEXT_PUBLIC_DAILY_DOMAIN=
DAILY_WEBHOOK_SECRET=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Cache / Rate Limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PREFIX=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=

# Tooling
ANALYZE=
